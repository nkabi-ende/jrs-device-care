{
  "name": "jrs-device-care",
  "compatibility_date": "2026-11-06",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/shop/*",
      "/api/academy/prospectus"
    ]
  },
  "main": "worker/productPreview.js",
  "rules": [
    {
      "type": "Data",
      "globs": [
        "**/*.pdf"
      ],
      "fallthrough": true
    }
  ],
  "d1_databases": [
    {
      "binding": "ACADEMY_LEADS",
      "database_name": "jrs-academy-leads"
    }
  ],
  "send_email": [
    {
      "name": "ACADEMY_EMAIL",
      "destination_address": "enquiries@jrsdevicecare.co.za"
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  }
}
